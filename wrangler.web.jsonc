{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhuguan-kpl-web",
  "main": "worker/web.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {"STANDALONE_WEB":"1", "APP_ORIGIN":"https://your-domain.example"},
  "d1_databases": [{"binding":"DB", "database_name":"zhuguan-kpl", "database_id":"00000000-0000-4000-8000-000000000000", "migrations_dir":"drizzle"}]
}
